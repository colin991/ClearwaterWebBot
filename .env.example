# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Public Clearwater website
WEBSITE_URL=https://cwrpvc.lol

# Private status connection shared with Vercel
BOT_API_KEY=
# Leave empty on Sparked Host: it supplies SERVER_PORT from your allocation.
# PORT=8102

# External integrations used by the bot (never put these on the website)
MELONLY_API_KEY=
ERLC_SERVER_KEY=

# Roblox group join-request sync. Keep this key on the bot host only.
# The two role IDs below are allowed to join the group.
ROBLOX_GROUP_ID=
ROBLOX_GROUP_API_KEY=
ROBLOX_GROUP_ALLOWED_ROLE_IDS=1514033664306974752,1514744040778760252
ROBLOX_GROUP_LOG_CHANNEL_ID=1536517651055120514
OWNER_DISCORD_IDS=1044686997194805280
OWNER_ROLE_IDS=1514033074948800683

# Website-only variables (set these in Vercel, not on the bot host)
# BOT_API_URL=https://your-bot-host.example.com
# BOT_API_KEY=use-the-same-private-key-as-the-bot
# OWNER_DISCORD_IDS=1044686997194805280
# One-way HMAC secret used for optional Clearwater Internet network bans.
# Generate a fresh long random value in Vercel. Never put this in code or on the bot host.
# IP_HASH_SECRET=
