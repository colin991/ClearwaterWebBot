# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Public Clearwater website
WEBSITE_URL=https://cwrpvc.lol

# Private status connection shared with Vercel
BOT_API_KEY=
# Leave empty on Sparked Host: it supplies SERVER_PORT from your allocation.
# PORT=8102

# External integrations used by the bot (never put these on the website)
MELONLY_API_KEY=
ERLC_SERVER_KEY=

# Roblox group join-request sync. Keep this key on the bot host only.
# The two role IDs below are allowed to join the group.
ROBLOX_GROUP_ID=
ROBLOX_GROUP_API_KEY=
ROBLOX_GROUP_ALLOWED_ROLE_IDS=1514033664306974752,1514744040778760252
ROBLOX_GROUP_LOG_CHANNEL_ID=1536517651055120514
INTERNET_PANEL_CHANNEL_ID=1540510308102176908
INTERNET_AUTOMOD_CHANNEL_ID=1540763074187894864
UPDATE_LOG_CHANNEL_ID=1538007463851200583
VC_ACTION_LOG_CHANNEL_ID=1538021552120135731
MESSAGE_FORWARD_SOURCE_IDS=1514667590608486400,1513609542468894877
MESSAGE_FORWARD_DESTINATION_ID=1544901668934525020
OWNER_DISCORD_IDS=1044686997194805280
OWNER_ROLE_IDS=1514033074948800683

# Website-only variables (set these in Vercel, not on the bot host)
# BOT_API_URL=https://your-bot-host.example.com
# BOT_API_KEY=use-the-same-private-key-as-the-bot
# Roblox OAuth app for Credit Store inventory claims (Vercel only).
# Redirect URL must be exactly: https://cwrpvc.lol/api/auth/roblox/callback
# Required scopes: openid profile user.inventory-item:read
# ROBLOX_OAUTH_CLIENT_ID=
# ROBLOX_OAUTH_CLIENT_SECRET=
# ROBLOX_OAUTH_REDIRECT_URI=https://cwrpvc.lol/api/auth/roblox/callback
# Required for GIF search in Clearwater Internet. Create a free key at
# https://developers.giphy.com/ and add it in Vercel only.
# GIPHY_API_KEY=
# OWNER_DISCORD_IDS=1044686997194805280
# One-way HMAC secret used for optional Clearwater Internet network bans.
# Generate a fresh long random value in Vercel. Never put this in code or on the bot host.
# IP_HASH_SECRET=
# Pepper used to salt-and-hash Discord IDs, IPs, and media tokens on the website.
# Generate a fresh long random value in Vercel. Falls back to IP_HASH_SECRET, then SESSION_SECRET.
# Required in production so network bans and public IDs work — do not leave all three empty.
# PII_HASH_SECRET=
# SESSION_SECRET=
# Block VPNs/proxies on sign-in and Clearwater Internet (default on). Set to 0 to disable.
# VPN_BLOCK=1
# Also treat hosting/datacenter IPs as blocked (stricter; more false positives). Default off.
# VPN_BLOCK_HOSTING=0
# Comma-separated Discord user IDs allowed to use a VPN (in addition to hardcoded allowlist).
# VPN_ALLOW_USER_IDS=
# Optional ProxyCheck.io key for higher VPN lookup limits: https://proxycheck.io/
# PROXYCHECK_API_KEY=
#
# Security release notes:
# - Keep BOT_API_KEY long and private. The bot host must not be publicly reachable
#   without that key; prefer firewalling it to Vercel egress only.
# - OWNER_DISCORD_IDS is break-glass ownership when Discord roles cannot be checked.
