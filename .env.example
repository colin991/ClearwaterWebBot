MESSAGE_FORWARD_DESTINATION_ID=1544901668934525020

# PCSO ER:LC private server (not ERLC_SERVER_KEY).
# Training report approve/deny POSTs to this base with header server-key: PCSOERLCAPI_KEY.
PCSOERLCAPI_URL=https://pcsoerlcapi.example.com
PCSOERLCAPI_KEY=
# On the bot host:
BOT_API_KEY=
SERVER_PORT=
MELONLY_API_KEY=
# On Vercel (same BOT_API_KEY; public base URL of the bot host, no trailing slash):
# BOT_API_URL=https://your-bot-host.example.com
# BOT_API_KEY=
# Optional fallback if you prefer Melonly on Vercel directly:
# MELONLY_API_KEY=

# Ownership / break-glass
OWNER_DISCORD_IDS=1044686997194805280
OWNER_ROLE_IDS=1514033074948800683

# Optional. Priority LEO-channel speech uses OpenAI voice "onyx" at speed 1.15.
OPENAI_API_KEY=

# Secondary server gate: join/stay only with a required role on the main Clearwater server
SECONDARY_GATE_GUILD_ID=1514189396184793169
SECONDARY_GATE_REQUIRED_ROLE_IDS=1053768758772109394,1514421440890409060,1514744040778760252,1536839307766267944

# Clearwater Radio: a second bot with no commands that sits in voice channel 1514128904783139018
# and relays push-to-talk audio from the Windows radio app (radio-app/).
RADIO_BOT_TOKEN=
# Public WebSocket address the app connects to. By default the relay shares SERVER_PORT
# (needs SERVER_PORT + BOT_API_KEY set): ws://<bot host IP or domain>:<SERVER_PORT>/radio
RADIO_PUBLIC_URL=
# Optional: give the relay its own port instead of SERVER_PORT.
# RADIO_PORT=
# Discord sign-in for the app. Uses DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET unless these are set.
# Add http://127.0.0.1:53682/callback under Developer Portal > OAuth2 > Redirects for that application.
# RADIO_OAUTH_CLIENT_ID=
# RADIO_OAUTH_CLIENT_SECRET=
# Optional: secret that signs radio sign-ins (defaults to a hash of RADIO_BOT_TOKEN; changing it signs everyone out).
# RADIO_KEY_SECRET=
# Web radio (cwpcso.com/radio) needs a secure wss:// address. By default the bot starts a free Cloudflare
# quick tunnel (downloads cloudflared into data/bin) and the website asks the bot for its address.
# Set RADIO_WEB_URL=wss://your-domain/radio to use your own HTTPS domain instead, or RADIO_WEB_TUNNEL=off to disable.
# RADIO_WEB_URL=
# RADIO_WEB_TUNNEL=off
# Radio talk log ("@member talked from 14:35:34-14:35:57"), panic history, weekly radio stats and staff actions
# go to the radio voice channel's chat unless set:
# RADIO_LOG_CHANNEL_ID=
# Discord voice channel callers wait in for 911; the radios list them as pending calls (default below).
# RADIO_911_CHANNEL_ID=1532197874690035843
# Scene timers: traffic stop / scene voice channel IDs, comma-separated. Dispatch (!C) radios and the
# radio staff page show how long each unit has been in one.
# RADIO_SCENE_CHANNEL_IDS=
# Optional overrides.
# RADIO_CHANNEL_ID=1514128904783139018
# RADIO_DOWNLOAD_CHANNEL_ID=1514190592005902336
