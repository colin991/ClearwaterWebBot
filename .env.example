# Discord application credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/discord/callback
# Redirect URL must match Discord Developer Portal → OAuth2 → Redirects.
# If unset, derived as https://<request-host>/api/auth/discord/callback.

DISCORD_GUILD_ID=

# Apollo zip hosts (no .git): HTTPS clone URL with a GitHub PAT that can read this private repo.
# Example: https://ghp_xxx@github.com/colin991/ClearwaterWebBot.git
# Or set GITHUB_TOKEN / GH_TOKEN instead. Not required when the server already has .git.
CLEARWATER_GIT_REMOTE=
# The bot checks origin/main every 5 minutes and restarts itself onto new commits (index.js supervisor).
# CLEARWATER_AUTO_UPDATE=0 turns that off; CLEARWATER_AUTO_UPDATE_MS changes the interval.
# CLEARWATER_AUTO_UPDATE=

# Main ER:LC private server (Clearwater / primary). Not the PCSO server.
ERLC_SERVER_KEY=
# Main Melonly panel API token (Settings â†’ Panel â†’ API Tokens).
# Department Melonly has no API tokens.
MELONLY_API_KEY=
# Cookie API key used to create web-based ticket transcripts.
COOKIE_API_KEY=

# PCSO roster sync (share the Google Sheet with this service-account email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n between lines in the host variable.
GOOGLE_PRIVATE_KEY=
PCSO_ROSTER_SPREADSHEET_ID=1gbwwPz8Sk9AE_AG6J8RRWGaEGLGPX6AdHW2FTxqY4Xc

# Roblox groups (keep these separate)
# Join-request whitelist: Clearwater Roleplay ERLC
ROBLOX_GROUP_ID=163783791
# `-funds` treasury: Clearwater-Whitelisted
ROBLOX_FUNDS_GROUP_ID=140437562
ROBLOX_GROUP_API_KEY=
ROBLOX_GROUP_ALLOWED_ROLE_IDS=1514033664306974752,1514744040778760252
ROBLOX_GROUP_LOG_CHANNEL_ID=1536517651055120514
# Host-only .ROBLOSECURITY value for `-funds` (group treasury). Never commit or paste in Discord.
ROBLOX_COOKIE=

# Discord channel IDs
INTERNET_PANEL_CHANNEL_ID=1540510308102176908
INTERNET_AUTOMOD_CHANNEL_ID=1540763074187894864
