{
  "name": "clearwater-radio",
  "productName": "Clearwater Radio",
  "version": "1.0.0",
  "description": "Clearwater Roleplay push-to-talk radio overlay",
  "main": "main.js",
  "author": "Clearwater Roleplay",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.clearwater.radio",
    "productName": "Clearwater Radio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "presence.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ClearwaterRadio-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clearwater Radio",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/colin991/ClearwaterWebBot/releases/latest/download"
      }
    ]
  }
}
